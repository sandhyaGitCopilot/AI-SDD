# jira-testgen credentials -- TEMPLATE
#
# Copy this file to `.env` and fill in your own values:
#
#     cp .env.example .env
#
# `.env` is excluded from version control. This template is not, which is why it must
# only ever contain placeholders. Never commit a real token, and never paste one into
# this file by mistake -- put it in `.env`.
#
# An environment variable you have already exported takes precedence over the same name
# here, so an export always wins over a stale file.
#
# Every value below is a placeholder. The tool will fail against Jira until you replace
# them with real ones.

# --- Jira (required) -------------------------------------------------------

# Your Jira Cloud site, with no trailing path.
JIRA_BASE_URL=https://your-site.atlassian.net

# The account email the API token belongs to.
JIRA_EMAIL=you@example.com

# Create one at id.atlassian.net -> Security -> API tokens.
# This is a secret. It is never written to a draft, a log, or an error message.
JIRA_API_TOKEN=replace-with-your-jira-api-token

# --- Generation service (required for `generate`) ---------------------------

# `approve` and `drafts` do not need this; only `generate` calls the AI service.
# NOTE: requirement text from your Jira issue is sent to this external service,
# with no consent prompt and no redaction. See the README before using real issues.
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key

# --- Optional site settings -------------------------------------------------
# Delete any line you do not need; the tool falls back to the documented default.

# Project to file test cases in. Defaults to the source issue's project.
#JIRA_TARGET_PROJECT=QA

# Name of the field holding acceptance criteria. Defaults to reading the description.
#JIRA_AC_FIELD=Acceptance Criteria

# Issue type for created test cases. Default: Task
#JIRA_ISSUE_TYPE=Test

# Link relationship between a test case and the requirement. Default: Relates
#JIRA_LINK_TYPE=Relates
